    "views": [
      {
        "viewName": "playable_tracks",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT t.id, t.title, t.artist, t.album, t.durationMs, t.artworkUri,\n    COALESCE(l.sourceUri, t.sourceUri) AS sourceUri,\n    CASE WHEN l.sourceUri IS NOT NULL THEN l.provider ELSE t.provider END AS provider,\n    t.isrc, t.attribution, t.licenseUrl, t.sourcePage\n    FROM tracks t LEFT JOIN local_track_matches m ON m.importedTrackId = t.id\n    LEFT JOIN tracks l ON l.id = m.localTrackId"
      }
    ],
